# Opcional: localização explícita do Codex CLI (ex.: C:\\Program Files\\nodejs\\codex.cmd)
PIXEL_CODEX_PATH=
# Opcional: diretório de dados. Por padrão, ./data no diretório da aplicação.
PIXEL_DATA_DIR=
# Opcional: porta HTTP local (padrão 8787)
PORT=8787
# Em produção, obrigatório: token aleatório de pelo menos 32 caracteres.
PIXEL_API_TOKEN=
# Em produção, para escutar conexões de proxy/túnel; padrão local é 127.0.0.1.
PIXEL_HOST=127.0.0.1
# No projeto Vercel, defina os quatro valores abaixo nas Environment Variables.
PIXEL_BACKEND_URL=https://seu-servidor-persistente.example.com
PIXEL_BACKEND_TOKEN=
PIXEL_SITE_USER=pixel
PIXEL_SITE_PASSWORD=

# Prospecção com provedor desacoplado; padrão: Overpass + Nominatim + tiles OSM.
PIXEL_PROSPECTING_PROVIDER=overpass
PIXEL_OVERPASS_URL=https://overpass-api.de/api/interpreter
PIXEL_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Opcional: se definido, Geoapify substitui o Nominatim para localizar cidades. Mantenha a chave apenas no .env/ambiente do servidor.
PIXEL_GEOAPIFY_API_KEY=
PIXEL_GEOAPIFY_URL=https://api.geoapify.com/v1/geocode/search
PIXEL_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Tamanho-alvo de cada segmento e limites públicos de pesquisa.
PIXEL_OVERPASS_CELL_KM=180
PIXEL_OVERPASS_MAX_SEGMENTS=24
# Identificador da aplicação enviado nas consultas a serviços OSM.
PIXEL_OSM_USER_AGENT=PIXEL-AI-STUDIO/0.2 (user-initiated OSM prospecting)
